# ── Dependencias ──────────────────────────────────────────────────────────
# Desde la rama v2-nextjs el proyecto es una app Next.js: node_modules/ se
# ignora, pero package-lock.json SÍ se versiona (Vercel lo usa para instalar
# exactamente las mismas versiones que en local).
node_modules/
yarn.lock
pnpm-lock.yaml

# ── Next.js ───────────────────────────────────────────────────────────────
# Salida de compilación y archivos que Next regenera por su cuenta.
.playwright-mcp/
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# ── Sistema operativo ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*

# ── Entorno y secretos ────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Editores e IDE ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~

# ── Temporales y build ────────────────────────────────────────────────────
dist/
build/
.cache/
.vercel/
*.tmp
*.bak

.claude/
CLAUDE.md
doc/
